{
  "name": "insurflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:full": "drizzle-kit migrate && next build",
    "build:full:cloudflare": "drizzle-kit migrate && opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "eslint && tsc --noEmit",
    "verify": "bun run check && bun run test:run && bun run test:e2e && bun run build",
    "sync": "bash scripts/sync-branch.sh",
    "sync:check": "bash scripts/sync-branch.sh --check",
    "sync:merge": "bash scripts/sync-branch.sh --merge",
    "services:start": "bash scripts/dev-services.sh start",
    "services:stop": "bash scripts/dev-services.sh stop",
    "services:status": "bash scripts/dev-services.sh status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bash scripts/dev-services.sh start && drizzle-kit push && next dev --turbo",
    "dev:e2e": "bash scripts/dev-services.sh start && drizzle-kit push && next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preview": "bun run build:full && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "prepare": "node -e \"if (process.env.CI !== 'true') { import('husky').then(m => m.default()) }\"",
    "postinstall": "bash scripts/stub-og-wasm.sh"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@axiomhq/js": "^1.4.0",
    "@daveyplate/better-auth-ui": "^3.3.15",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@neondatabase/serverless": "^1.0.2",
    "@opennextjs/cloudflare": "^1.16.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@t3-oss/env-nextjs": "0.13.10",
    "better-auth": "^1.4.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-drizzle": "^0.2.3",
    "happy-dom": "^20.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^5.82.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.61.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,md,css}": [
      "prettier --write"
    ]
  }
}
